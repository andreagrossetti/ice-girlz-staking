# Copy to .env.local (dev) or set in Vercel per environment.

# --- Network: "polygon" (production, default) or "polygonAmoy" (staging) ---
NEXT_PUBLIC_NETWORK=polygon

# Read RPC: either a full URL or an Infura key (URL is derived from the network)
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_INFURA_API_KEY=

# WalletConnect / Reown project id (defaults to the current one)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Contract addresses (defaults = Polygon mainnet production contracts) ---
# Required for staging: set them to the testnet deployments.
NEXT_PUBLIC_ICE_GIRLZ_ADDRESS=
NEXT_PUBLIC_ICE_FOLKS_ADDRESS=
NEXT_PUBLIC_FROST_ADDRESS=
NEXT_PUBLIC_STAKING_ADDRESS=
NEXT_PUBLIC_RAFFLES_ADDRESS=

# --- Raffle images (S3) ---
# Use a separate bucket for staging. Public URL of the "raffles" folder, no trailing slash.
NEXT_PUBLIC_RAFFLES_IMAGE_BASE_URL=https://icegirlz.s3.ap-south-1.amazonaws.com/raffles
AWS_S3_REGION=ap-south-1
# Optional, for S3-compatible storage (Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com, region "auto")
AWS_S3_ENDPOINT=
AWS_S3_BUCKET_NAME=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
